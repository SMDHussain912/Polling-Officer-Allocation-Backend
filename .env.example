# Polling Officer backend — copy to .env and fill in. NEVER commit .env.
PORT=5000
NODE_ENV=development
# Local MongoDB (for offline testing):
# MONGODB_URI=mongodb://127.0.0.1:27017/polling_system
# MongoDB Atlas (production / fastest pick):
MONGODB_URI=mongodb+srv://<your-atlas-user>:<your-atlas-password>@cluster0.abc12.mongodb.net/polling_system?retryWrites=true&w=majority

SESSION_SECRET=<long-random-string>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-password>

# --- SMS (India) ---
# mock = demo only (no real SMS). http = generic gateway. msg91 = MSG91 (recommended).
SMS_PROVIDER=mock
SMS_PROVIDER_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=
SMS_TIMEOUT_MS=15000
SMS_EXTRA_HEADERS=
SMS_WEBHOOK_SECRET=
# MSG91 Flow API (optional — when set, flow is used instead of plain SMS API)
MSG91_FLOW_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=1166531953219753
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TIMEOUT_MS=15000

# --- Message content defaults ---
ELECTION_NAME=General Elections
VOTING_HOURS=7:00 AM - 6:00 PM
ELECTION_HELPLINE=
REPORTING_DATE=
PUBLIC_BASE_URL=http://localhost:5000

# --- Google / Gmail / misc (existing) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ALLOWED_ORIGINS=
TOKEN_ENCRYPTION_KEY=
AUTHORIZED_GMAILS=
ENABLE_SWAGGER=true
SWAGGER_USERNAME=swagger
SWAGGER_PASSWORD=
DEFAULT_REQUIRED_OFFICERS=4

# Request logging: prints every API request + its (redacted) response to the
# console. On by default in dev, OFF in production unless set to true here.
# Set LOG_REQUEST_BODIES=true to also log successful request bodies.
LOG_REQUESTS=
LOG_REQUEST_BODIES=
